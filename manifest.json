{
  "manifest_version": 3,
  "name": "aBMICalculator - Health & Biometric Suite",
  "version": "1.0.0",
  "description": "Instant clinical health calculators: BMI (WHO), Calorie & Macro, WHR, Body Fat %, BMR/TDEE, Ideal Weight, Ovulation & Pregnancy.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "aBMI Health Calculators",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel"
  ],
  "omnibox": {
    "keyword": "bmi"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
